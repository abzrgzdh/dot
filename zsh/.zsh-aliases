alias dush='du -sh * | sort -h'

alias gcc=gcc-15

alias ed='rlwrap -H "$HOME/.ed_history" ged --verbose --traditional --prompt=":"'

alias ytdlpl='ytdl -pl -ar'

alias octave='octave -q'

alias ollama='OLLAMA_FLASH_ATTENTION="1" OLLAMA_KV_CACHE_TYPE="q8_0" ollama'

# alias pdfmk='latexmk -dvi- -pdf -verbose -file-line-error -synctex=1 -interaction=nonstopmode -shell-escape -output-directory=build'

# Julia Notebooks
# Works only environments that have IJulia installed
jn() {
    julia --project=. -e 'using IJulia; notebook(dir="'"$1"'")'
}
