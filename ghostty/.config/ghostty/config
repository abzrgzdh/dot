window-decoration = none
window-padding-balance = true
window-padding-color = extend
window-height = 1000
window-width = 1000
window-padding-x = 2
window-padding-y = 0

cursor-style-blink = false

shell-integration = zsh
shell-integration-features = sudo,title,no-cursor

# keybind = clear
# keybind = super+backspace=text:\x17
keybind = super+backspace=text:\x17
keybind = alt+backspace=text:\x1b\x7f
keybind = super+delete=text:\x0b
keybind = super+comma=ignore

# emacs emacs emacs!
keybind = super+d=esc:d
keybind = super+f=esc:f
keybind = super+b=esc:b
keybind = super+a=esc:a
keybind = super+e=esc:e

keybind = super+h=esc:h
keybind = super+l=esc:l
keybind = super+k=esc:k
keybind = super+j=esc:j
keybind = super+w=esc:w
keybind = super+shift+w=close_window
keybind = super+n=ignore
keybind = super+shift+n=new_window
keybind = super+period=esc:.

keybind = super+period=esc:period
keybind = super+period=esc:.

keybind = super+semicolon=ignore

macos-option-as-alt = left

clipboard-paste-protection = false

